APP_NAME="Restaurant Menu SaaS"
APP_ENV=local
DEMO_LOGIN_ENABLED=false
DEMO_LOGIN_HOSTS=ruflo.test
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=deprecations
LOG_LEVEL=info
LOG_DAILY_DAYS=14

HEALTH_CHECK_DATABASE=true
HEALTH_CHECK_CACHE=true
HEALTH_CHECK_PRIVATE_STORAGE=true
HEALTH_CHECK_LOGS=true

ERROR_NOTIFICATIONS_ENABLED=false
ERROR_NOTIFICATION_EMAIL=
ERROR_NOTIFICATION_CACHE_STORE=file
ERROR_NOTIFICATION_COOLDOWN_SECONDS=300

# SQLite database is stored at database/database.sqlite.
# The file is inside the project, outside public/, so it is safe for shared hosting.
DB_CONNECTION=sqlite
DB_DATABASE=
DB_FOREIGN_KEYS=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

SUPERADMIN_NAME="Platform Superadmin"
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
